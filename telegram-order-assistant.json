    {
      "parameters": {
        "jsCode": "const text = $('Telegram Trigger').first().json.message.text ?? '';\nconst match = text.trim().match(/^(.+?)\\s*-\\s*(\\+?[0-9٠-٩]{8,15})$/u);\n\nreturn $input.all().map((order) => ({\n  json: {\n    ...order.json,\n    details_valid: Boolean(match),\n    customer_name: match ? match[1].trim() : null,\n    phone: match\n      ? match[2].replace(/[٠-٩]/g, (digit) => '٠١٢٣٤٥٦٧٨٩'.indexOf(digit))\n      : null,\n  },\n}));"
      },
