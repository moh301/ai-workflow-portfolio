    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const text = (item.json.message?.text ?? '').trim();\n  const parts = text.split(/\\s+/);\n\n  if (\n    parts.length !== 2 ||\n    !/^[1-9]\\d*$/.test(parts[0]) ||\n    !/^(done|cancel)$/i.test(parts[1])\n  ) {\n    throw new Error('اكتب رقم الأوردر ثم الحالة، مثل: 3 Done');\n  }\n\n  item.json.Order_Number = Number(parts[0]);\n  item.json.Status = parts[1].toLowerCase();\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
