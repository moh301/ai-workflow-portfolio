{
  "name": "Feedback Sentiment Router",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Feedback",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Feedback",
              "placeholder": "put your feedback her...."
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
